<?xml version="1.0" encoding="utf-8"?>
<!-- macOS dock tooltip in the Liquid Glass style: a full capsule of translucent slate, lighter at the top,
     with a faint highlight edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#B3545A66"
        android:endColor="#B33A3F49" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
    <corners android:radius="100dp" />
</shape>
